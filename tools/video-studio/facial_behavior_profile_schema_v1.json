{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video-studio.invalid/schemas/facial-behavior-profile-v1.json",
  "title": "Local Video Studio facial behavior sidecar v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "subject_id", "source_file", "base_profile", "analysis", "units"],
  "properties": {
    "schema_version": {"const": "facial-behavior-profile/v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "source_file": {"type": "string", "minLength": 1},
    "base_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile_id", "manifest_path"],
      "properties": {
        "schema_version": {"const": "behavior-profile/v1"},
        "profile_id": {"type": "string"},
        "manifest_path": {"type": "string"}
      }
    },
    "analysis": {"type": "object", "additionalProperties": true},
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "start_s", "end_s", "duration_s", "frames_total", "frames_accepted", "accepted_frame_ratio", "face_quality_weight"]
      }
    }
  }
}
